meta {
  name: 25 - Export PDF Report
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/dashboard/export?format=pdf&date_from=2026-11-04&date_to=2026-11-04
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/pdf
}
