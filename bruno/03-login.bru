meta {
  name: 03 - Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "janu_supervisor",
    "password": "PasswordMigas2026!"
  }
}

script:post-response {
  if (res.status === 200 && res.body.access_token) {
    bru.setVar("authToken", res.body.access_token);
  }
}

assert {
  res.status: eq 200
  res.body.token_type: eq bearer
  res.body.access_token: isDefined
}
