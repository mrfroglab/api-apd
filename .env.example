# Port server api-apd (default: 8000; untuk workstation dengan port bentrok gunakan 8740)
PORT=8000

# URL service ml-apd YOLO11 inference (default: http://localhost:8001; lokal 8741)
ML_SERVICE_URL=http://localhost:8001

# Allowed CORS origins (pisahkan dengan koma, contoh: http://localhost:3000)
CORS_ORIGINS=*

# JWT Secret Key (wajib diganti untuk production)
SECRET_KEY=super-secret-key-pdu-migas-apd-2026

# Database SQLite aiosqlite connection URI
DATABASE_URL=sqlite+aiosqlite:///./apd_gateway.db

# Zona waktu operasional (default: Asia/Jakarta)
APP_TZ=Asia/Jakarta

# Titik waktu acuan demo (opsional, jika diset dipakai sebagai 'now')
# PMLD_DEMO_NOW=2026-11-04T10:42:18+07:00
